{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "时光围棋",
  "version": "1.0.0",
  "identifier": "com.shiguang.go",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "时光围棋",
        "width": 1380,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/katago/**/*",
      "resources/katago-estimate/**/*",
      "resources/katago-human/**/*",
      "resources/gnugo/**/*"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
