{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "时光围棋",
  "version": "1.2.0",
  "identifier": "com.shiguang.go",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "时光围棋",
        "width": 1380,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/katago/abseil_dll.dll",
      "resources/katago/analysis.cfg",
      "resources/katago/bz2.dll",
      "resources/katago/cacert.pem",
      "resources/katago/contribute_example.cfg",
      "resources/katago/default_gtp.cfg",
      "resources/katago/gtp_human5k_example.cfg",
      "resources/katago/gtp_human9d_search_example.cfg",
      "resources/katago/katago.exe",
      "resources/katago/libcrypto-3-x64.dll",
      "resources/katago/libprotobuf.dll",
      "resources/katago/libssl-3-x64.dll",
      "resources/katago/match_example.cfg",
      "resources/katago/model.bin.gz",
      "resources/katago/msvcp140.dll",
      "resources/katago/msvcp140_1.dll",
      "resources/katago/msvcp140_2.dll",
      "resources/katago/msvcp140_atomic_wait.dll",
      "resources/katago/msvcp140_codecvt_ids.dll",
      "resources/katago/nvinfer_10.dll",
      "resources/katago/nvinfer_builder_resource_sm89_10.dll",
      "resources/katago/nvinfer_plugin_10.dll",
      "resources/katago/nvonnxparser_10.dll",
      "resources/katago/README.txt",
      "resources/katago/vcruntime140.dll",
      "resources/katago/vcruntime140_1.dll",
      "resources/katago/vcruntime140_threads.dll",
      "resources/katago/z.dll",
      "resources/katago/zip.dll",
      "resources/katago-estimate/abseil_dll.dll",
      "resources/katago-estimate/analysis_example.cfg",
      "resources/katago-estimate/bz2.dll",
      "resources/katago-estimate/cacert.pem",
      "resources/katago-estimate/contribute_example.cfg",
      "resources/katago-estimate/default_gtp.cfg",
      "resources/katago-estimate/g170e-b20c256x2-s2430231552-d525879064.bin.gz",
      "resources/katago-estimate/gtp_human5k_example.cfg",
      "resources/katago-estimate/gtp_human9d_search_example.cfg",
      "resources/katago-estimate/katago.exe",
      "resources/katago-estimate/libcrypto-3-x64.dll",
      "resources/katago-estimate/libprotobuf.dll",
      "resources/katago-estimate/libssl-3-x64.dll",
      "resources/katago-estimate/match_example.cfg",
      "resources/katago-estimate/msvcp140.dll",
      "resources/katago-estimate/msvcp140_1.dll",
      "resources/katago-estimate/msvcp140_2.dll",
      "resources/katago-estimate/msvcp140_atomic_wait.dll",
      "resources/katago-estimate/msvcp140_codecvt_ids.dll",
      "resources/katago-estimate/README.txt",
      "resources/katago-estimate/vcruntime140.dll",
      "resources/katago-estimate/vcruntime140_1.dll",
      "resources/katago-estimate/vcruntime140_threads.dll",
      "resources/katago-estimate/z.dll",
      "resources/katago-estimate/zip.dll",
      "resources/katago-human/b18c384nbt-humanv0.bin.gz",
      "resources/gnugo/BUILD.md",
      "resources/gnugo/COPYING",
      "resources/gnugo/gnugo-3.8-source.tar.gz",
      "resources/gnugo/gnugo.exe",
      "resources/gnugo/modern-cmake.patch",
      "resources/gnugo/README",
      "resources/katago/cudart64_13.dll",
      "resources/katago/nvrtc64_130_0.dll",
      "resources/katago/nvrtc-builtins64_132.dll",
      "resources/third-party/**/*"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "compression": "lzma"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
